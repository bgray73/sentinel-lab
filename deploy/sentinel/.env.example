# The dashboard stays on the local host unless this is deliberately changed.
SENTINEL_BIND_ADDRESS=127.0.0.1
SENTINEL_PORT=4100
SENTINEL_IMAGE=sentinel-lab:local

# Safe first-run defaults. Enable live capabilities individually after adding credentials.
SENTINEL_REAL_CHECKS=false
SENTINEL_REAL_NOTIFICATIONS=false
SENTINEL_REAL_TELEMETRY=false
SENTINEL_REAL_CMDB=false
SENTINEL_REAL_HARDWARE=false

# Keep authentication disabled only while the service is bound to loopback.
# For remote access, use proxy mode behind LabOps OIDC or another trusted auth proxy.
SENTINEL_AUTH_MODE=disabled
SENTINEL_AUTH_PROXY_SECRET=
SENTINEL_AUTH_ADMIN_GROUPS=sentinel-admins
SENTINEL_AUTH_OPERATOR_GROUPS=sentinel-operators
SENTINEL_METRICS_TOKEN=
SENTINEL_AUTH_AUDIT_RETENTION_DAYS=90
SENTINEL_AUTH_AUDIT_MAX_EVENTS=10000
SENTINEL_BACKUPS_ENABLED=true
SENTINEL_BACKUP_INTERVAL_HOURS=24
SENTINEL_BACKUP_MAX_COUNT=14
SENTINEL_BACKUP_REPLICA_DIR=

# Stage 21 non-destructive recovery drills. Run one manually before enabling
# the weekly schedule. Auto prefers a verified external replica when present.
SENTINEL_RECOVERY_DRILLS_ENABLED=false
SENTINEL_RECOVERY_DRILL_INTERVAL_DAYS=7
SENTINEL_RECOVERY_DRILL_RETENTION_DAYS=180
SENTINEL_RECOVERY_DRILL_SOURCE=auto

# Stage 22 isolated Proxmox guest drills. Keep false until the dedicated node,
# scratch storage, PBS storage, VMID range, and drill-only token are ready.
SENTINEL_REAL_GUEST_DRILLS=false
SENTINEL_GUEST_DRILL_RETENTION_DAYS=180
SENTINEL_GUEST_DRILL_NODE=
SENTINEL_GUEST_DRILL_BACKUP_STORAGE=
SENTINEL_GUEST_DRILL_TARGET_STORAGE=
SENTINEL_GUEST_DRILL_SOURCE_TYPE=qemu
SENTINEL_GUEST_DRILL_SOURCE_VMID=
SENTINEL_GUEST_DRILL_VMID_MIN=900000
SENTINEL_GUEST_DRILL_VMID_MAX=900099
SENTINEL_GUEST_DRILL_BOOT_SECONDS=30
PVE_DRILL_TOKEN_ID=
PVE_DRILL_TOKEN_SECRET=
PVE_DRILL_TOKEN_SECRET_FILE=

# Stage 23 unified disaster-recovery readiness policy. Replica, live guest
# drills, and live PBS evidence remain optional until explicitly required.
SENTINEL_RECOVERY_RPO_HOURS=24
SENTINEL_RECOVERY_APP_DRILL_MAX_AGE_DAYS=8
SENTINEL_RECOVERY_GUEST_DRILL_MAX_AGE_DAYS=30
SENTINEL_RECOVERY_REQUIRE_REPLICA=false
SENTINEL_RECOVERY_REQUIRE_GUEST_DRILL=false
SENTINEL_RECOVERY_REQUIRE_PBS=false

# Stage 17 integrations. Prefer the matching *_FILE variable with a mounted
# Docker secret for webhook URLs, SMTP credentials, passwords, and tokens.
SENTINEL_WEBHOOK_URL=
SENTINEL_SLACK_WEBHOOK_URL=
SENTINEL_TEAMS_WEBHOOK_URL=
SENTINEL_SMTP_URL=
SENTINEL_ALERT_EMAIL_TO=
SENTINEL_ALERT_EMAIL_FROM=sentinel@localhost
SENTINEL_SERVICENOW_URL=
SENTINEL_SERVICENOW_USERNAME=
SENTINEL_SERVICENOW_PASSWORD=
SENTINEL_SERVICENOW_TOKEN=

# Stage 18 CMDB and change integration. Keep live sync and automatic changes
# disabled until a dry-run preview and ServiceNow data-source setup are verified.
SENTINEL_REAL_SERVICENOW_CMDB=false
SENTINEL_SERVICENOW_CMDB_SOURCE=Other Automated
SENTINEL_SERVICENOW_CMDB_FEED=SentinelLab
SENTINEL_SERVICENOW_CMDB_INTERVAL_MINUTES=60
SENTINEL_SERVICENOW_AUTO_CHANGE=false

# Stage 19 Proxmox operational-health thresholds.
SENTINEL_PROXMOX_OPERATIONS_INTERVAL_SECONDS=300
SENTINEL_PROXMOX_OPERATIONS_RETENTION_DAYS=30
SENTINEL_PROXMOX_BACKUP_WARNING_HOURS=26
SENTINEL_PROXMOX_BACKUP_CRITICAL_HOURS=48
SENTINEL_PROXMOX_STORAGE_WARNING_PERCENT=80
SENTINEL_PROXMOX_STORAGE_CRITICAL_PERCENT=90

# Stage 20 Proxmox Backup Server health. Prefer PBS_TOKEN_SECRET_FILE in a
# deployed environment and use an audit-only API token.
PBS_URL=
PBS_TOKEN_ID=
PBS_TOKEN_SECRET=
PBS_TOKEN_SECRET_FILE=
SENTINEL_PBS_INTERVAL_SECONDS=900
SENTINEL_PBS_RETENTION_DAYS=30
SENTINEL_PBS_SNAPSHOT_WARNING_HOURS=26
SENTINEL_PBS_SNAPSHOT_CRITICAL_HOURS=48
SENTINEL_PBS_VERIFICATION_WARNING_DAYS=7
SENTINEL_PBS_GC_WARNING_DAYS=7
SENTINEL_PBS_STORAGE_WARNING_PERCENT=80
SENTINEL_PBS_STORAGE_CRITICAL_PERCENT=90

# Stage 16 collectors are enrolled from the Sites dashboard. These values are
# used on each remote collector, not on the central Sentinel container.
SENTINEL_URL=https://sentinel.example.net
SENTINEL_COLLECTOR_TOKEN=
SENTINEL_COLLECTOR_INTERVAL_SECONDS=60

# Stage 14 OIDC gateway settings. Register the callback URL with the provider.
SENTINEL_OIDC_PORT=4180
SENTINEL_OIDC_ISSUER_URL=
SENTINEL_OIDC_CLIENT_ID=
SENTINEL_OIDC_CLIENT_SECRET=
SENTINEL_OIDC_COOKIE_SECRET=
SENTINEL_OIDC_REDIRECT_URL=https://sentinel.example.net/oauth2/callback

PVE_URL=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
LOKI_URL=
LABOPS_EXPORT_TOKEN=
SNMP_EXPORTER_URL=
SENTINEL_REDFISH_TARGETS=[]
SENTINEL_SNMP_TARGETS=[]
