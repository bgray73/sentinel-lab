# The dashboard stays on the local host unless this is deliberately changed.
SENTINEL_BIND_ADDRESS=127.0.0.1
SENTINEL_PORT=4100
SENTINEL_IMAGE=sentinel-lab:local

# Safe first-run defaults. Enable live capabilities individually after adding credentials.
SENTINEL_REAL_CHECKS=false
SENTINEL_REAL_NOTIFICATIONS=false
SENTINEL_REAL_TELEMETRY=false
SENTINEL_REAL_CMDB=false
SENTINEL_REAL_HARDWARE=false

PVE_URL=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
LOKI_URL=
LABOPS_EXPORT_TOKEN=
SNMP_EXPORTER_URL=
SENTINEL_REDFISH_TARGETS=[]
SENTINEL_SNMP_TARGETS=[]
