# Native sentinel01 defaults. Keep the service on loopback until authenticated
# ingress and firewall restrictions have been tested.
PORT=4100
SENTINEL_LISTEN_ADDRESS=127.0.0.1
SENTINEL_AUTH_MODE=disabled
SENTINEL_ENABLE_WORKLOAD_ACTIONS=false

DATABASE_PATH=/var/lib/sentinel/sentinel.db
SENTINEL_DATA_FILE=/var/lib/sentinel/monitoring.json
SENTINEL_TELEMETRY_FILE=/var/lib/sentinel/telemetry.json
SENTINEL_CMDB_FILE=/var/lib/sentinel/cmdb.json
SENTINEL_HARDWARE_OPERATIONS_FILE=/var/lib/sentinel/hardware-operations.json
SENTINEL_NETWORK_FILE=/var/lib/sentinel/network.json
SENTINEL_AUTH_AUDIT_FILE=/var/lib/sentinel/security-audit.json
SENTINEL_COLLECTOR_FILE=/var/lib/sentinel/collectors.json
SENTINEL_BACKUP_DIR=/var/lib/sentinel/backups
SENTINEL_RESTORE_POINT_DIR=/var/lib/sentinel/restore-points

# Read-only first deployment. Set the URL and token identity after creating a
# PVEAuditor token. Put only the token value in the referenced root-owned file.
PVE_URL=
PVE_TOKEN_ID=
PVE_TOKEN_SECRET_FILE=/etc/sentinel/secrets/pve-token

# Live actions, notifications, drills, external AI, and write integrations stay
# disabled until the read-only pilot has been validated.
SENTINEL_REAL_CHECKS=false
SENTINEL_REAL_NOTIFICATIONS=false
SENTINEL_REAL_TELEMETRY=false
SENTINEL_REAL_CMDB=false
SENTINEL_REAL_HARDWARE=false
SENTINEL_REAL_NETWORK=false
SENTINEL_REAL_JEV=false
SENTINEL_REAL_GUEST_DRILLS=false
SENTINEL_RECOVERY_DRILLS_ENABLED=false
SENTINEL_RECOVERY_ALERTS_ENABLED=false
SENTINEL_CAPACITY_ALERTS_ENABLED=false
SENTINEL_NETWORK_ALERTS_ENABLED=false
SENTINEL_REAL_SERVICENOW_CMDB=false
SENTINEL_SERVICENOW_AUTO_CHANGE=false
