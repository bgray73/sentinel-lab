[Unit]
Description=Sentinel homelab monitoring service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sentinel
Group=sentinel
WorkingDirectory=/opt/sentinel/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/sentinel/sentinel.env
ExecStart=/usr/bin/node /opt/sentinel/current/server-dist/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/sentinel

[Install]
WantedBy=multi-user.target
