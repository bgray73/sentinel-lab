GRAFANA_ADMIN_USER=sentinel-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
ALLOY_BIND_ADDRESS=127.0.0.1
# Change to the management-interface address only when network devices must send syslog.
SYSLOG_BIND_ADDRESS=127.0.0.1
# Image variables may be pinned to versions approved for your environment.
LOKI_IMAGE=grafana/loki:3.7.0
GRAFANA_IMAGE=grafana/grafana:latest
ALLOY_IMAGE=grafana/alloy:latest
SNMP_EXPORTER_IMAGE=quay.io/prometheus/snmp-exporter:latest
SNMP_EXPORTER_BIND_ADDRESS=127.0.0.1
SNMP_USERNAME=sentinel
SNMP_AUTH_PASSWORD=replace-with-a-long-random-password
SNMP_PRIV_PASSWORD=replace-with-a-different-long-random-password
