{
  "name": "sentinel-test-bed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node --watch --import tsx server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server-build.json",
    "build:production": "pnpm build && pnpm build:server",
    "start": "node server-dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "nodemailer": "^9.1.1",
    "react": "latest",
    "react-dom": "latest",
    "tsx": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
